+            "fs_list_page",
+            move |mount_idx: i32, path: String, after: String, limit: u64|
+                  -> hyperlight_host::Result<Vec<u8>> {
+                let _profile = prof.host("fs_list_page");
+                let count = (limit.min(128)) as usize;
+                if count == 0 {
+                    return Ok(status_vec(errno::EINVAL));
+                }
+                let backend = match mounts.get(mount_idx) {
+                    Ok(b) => b,
+                    Err(code) => return Ok(status_vec(code)),
+                };
+                let page = match backend.list_page(&path, &after, count) {
+                    Ok(page) => page,
+                    Err(e) => return Ok(errno_vec(e)),
+                };
+                if page.len() > count {
+                    return Ok(status_vec(errno::EIO));
+                }
+                let mut buf = vec![0; 8];
+                let mut previous = after.as_str();
+                for entry in &page {
+                    if entry.name.as_str() <= previous || entry.name.len() > NAME_MAX
+                        || entry.name.contains(['/', '\0']) || entry.name == "." || entry.name == ".." {
+                        return Ok(status_vec(errno::EIO));
+                    }
+                    buf.push(entry.is_dir as u8);
+                    buf.extend((entry.name.len() as u16).to_le_bytes());
+                    buf.extend(entry.name.as_bytes());
+                    previous = &entry.name;
+                }
+                buf[4..8].copy_from_slice(&(page.len() as u32).to_le_bytes());
+                Ok(buf)
+            },
+        )?;
+    }
